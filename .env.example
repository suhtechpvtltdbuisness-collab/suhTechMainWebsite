# IMPORTANT: set these on the *website* Vercel project (suhtech.top),
# not only on suh-tech-main-backend. /api/contact runs in the website.

# Neon Postgres (same DB as suh_tech_main_backend / Admin messages)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Gmail SMTP for contact form notifications
SMTP_USER=info.suhtech@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_RECEIVER_EMAIL=info.suhtech@gmail.com
